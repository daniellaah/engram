# OpenAI-compatible API configuration
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-5.6
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60

# Optional web search tool
SERPAPI_API_KEY=your_serpapi_api_key_here

